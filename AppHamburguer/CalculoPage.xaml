<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHamburguer.CalculoPage"
             Title="Etanol x Gasolina">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Preço do Etanol (R$)"
                FontSize="16"
            />

            <Entry
                x:Name="txtEtanol"
                Placeholder="Ex: 3,89"
                Keyboard="Numeric"
            />
               
            
            
            <Label 
                Text="Preço da Gasolina (R$)"
                FontSize="16"
            />
            
            <Entry
                x:Name="txtGasolina"
                Placeholder="Ex: 4,89"
                Keyboard="Numeric"
            />

            <Button
                Text="Calcular"
                Clicked="OnCalcularClicked"
                Margin="0,10,0,0"
            />

            <Label
                x:Name="lblResultado"  
                FontSize="10"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,0"
                TextColor="DarkGreen"
            />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>